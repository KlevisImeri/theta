package hu.bme.mit.theta.analysis.algorithm.cegar;

import static com.google.common.base.Preconditions.checkNotNull;

import com.google.common.base.Stopwatch;
import hu.bme.mit.theta.analysis.Cex;
import hu.bme.mit.theta.analysis.Prec;
import hu.bme.mit.theta.analysis.algorithm.Proof;
import hu.bme.mit.theta.analysis.algorithm.SafetyChecker;
import hu.bme.mit.theta.analysis.algorithm.SafetyResult;
import hu.bme.mit.theta.analysis.runtimemonitor.MonitorCheckpoint;
import hu.bme.mit.theta.analysis.utils.ProofVisualizer;
import hu.bme.mit.theta.common.Utils;
import hu.bme.mit.theta.common.exception.NotSolvableException;
import hu.bme.mit.theta.common.logging.Logger;
import hu.bme.mit.theta.common.logging.Logger.Level;
import hu.bme.mit.theta.common.logging.NullLogger;
import hu.bme.mit.theta.common.visualization.writer.JSONWriter;
import hu.bme.mit.theta.common.visualization.writer.WebDebuggerLogger;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicReference;
import java.util.function.Supplier;
import java.util.Timer;
import java.util.TimerTask;

/**
 * Counterexample-Guided Abstraction Refinement (CEGAR) loop implementation, that uses an Abstractor
 * to explore the abstract state space and a Refiner to check counterexamples and refine them if
 * needed. It also provides certain statistics about its execution.
 */
public final class CegarChecker<P extends Prec, Pr extends Proof, C extends Cex>
        implements SafetyChecker<Pr, C, P> {

    private final Abstractor<P, Pr> abstractor;
    private final Refiner<P, Pr, C> refiner;
    private final Logger logger;
    private final Pr proof;
    private final ProofVisualizer<? super Pr> proofVisualizer;
    private final Boolean computePartialResult;
    private final long timeoutMs; // 0 means no timeout  

    private CegarChecker(
            final Abstractor<P, Pr> abstractor,
            final Refiner<P, Pr, C> refiner,
            final Logger logger,
            final ProofVisualizer<? super Pr> proofVisualizer,
            final Boolean computePartialResult,
            final long timeoutMs) {
        this.abstractor = checkNotNull(abstractor);
        this.refiner = checkNotNull(refiner);
        this.logger = checkNotNull(logger);
        proof = abstractor.createProof();
        this.proofVisualizer = checkNotNull(proofVisualizer);
        this.computePartialResult = checkNotNull(computePartialResult);
        this.timeoutMs = checkNotNull(timeoutMs);
    }

    public static <P extends Prec, Pr extends Proof, C extends Cex> CegarChecker<P, Pr, C> create(
            final Abstractor<P, Pr> abstractor,
            final Refiner<P, Pr, C> refiner,
            final Logger logger,
            final ProofVisualizer<? super Pr> proofVisualizer,
            final Boolean computePartialResult, 
            final long timeoutMs) {
      return new CegarChecker<>(
        abstractor, refiner, logger, proofVisualizer, computePartialResult, timeoutMs
      );
    }

    public static <P extends Prec, Pr extends Proof, C extends Cex> CegarChecker<P, Pr, C> create(
            final Abstractor<P, Pr> abstractor,
            final Refiner<P, Pr, C> refiner,
            final ProofVisualizer<Pr> proofVisualizer,
            final Boolean computePartialResult) {
        return create(abstractor, refiner, NullLogger.getInstance(), proofVisualizer, computePartialResult, 0);
    }

    public static <P extends Prec, Pr extends Proof, C extends Cex> CegarChecker<P, Pr, C> create(
            final Abstractor<P, Pr> abstractor,
            final Refiner<P, Pr, C> refiner,
            final ProofVisualizer<Pr> proofVisualizer) {
        return create(abstractor, refiner, NullLogger.getInstance(), proofVisualizer, false, 0);
    }

    public static <P extends Prec, Pr extends Proof, C extends Cex> CegarChecker<P, Pr, C> create(
            final Abstractor<P, Pr> abstractor,
            final Refiner<P, Pr, C> refiner,
            final Logger logger,
            final ProofVisualizer<? super Pr> proofVisualizer) {
        return create(abstractor, refiner, logger, proofVisualizer, false, 0);
    }

    public Pr getProof() {
        return proof;
    }

    private static class StatsHolder {
        long abstractorTime = 0;
        long refinerTime = 0;
        int iteration = 0;
    }

    @Override
    @SuppressWarnings("deprecation")
    public SafetyResult<Pr, C> check(final P initPrec) {
        logger.write(Level.INFO, "Configuration: %s%n", this);
        final Stopwatch stopwatch = Stopwatch.createStarted();
        final StatsHolder statsHolder = new StatsHolder();
        final Supplier<CegarStatistics> getStats = () -> {
            stopwatch.stop();
            return new CegarStatistics(
                stopwatch.elapsed(TimeUnit.MILLISECONDS),
                statsHolder.abstractorTime,
                statsHolder.refinerTime,
                statsHolder.iteration
            );
        };
        
        final AtomicReference<RefinerResult<P, C>> refinerResult = new AtomicReference<>(null);
        final AtomicReference<AbstractorResult> abstractorResult = new AtomicReference<>(null);
        final AtomicReference<P> prec = new AtomicReference<>(initPrec);
        final AtomicReference<SafetyResult<Pr, C>> result = new AtomicReference<>(null);
        
        WebDebuggerLogger wdl = WebDebuggerLogger.getInstance();
        // WARN: THE PROF AND PREF SHOULD BE DEEP CLONED CORRECLY -------------------------------------
        final AtomicReference<Pr> proofCopy = new AtomicReference<>(proof); 
        final AtomicReference<P> precCopy = new AtomicReference<>(prec.get());

        final Timer timer = new Timer(true);
        
        final Thread cegarLoop = new Thread(() -> {
            try {
                do {
                    statsHolder.iteration++;
                    
                    // Update copies at the beginning of each iteration
                    proofCopy.set(proof);
                    precCopy.set(prec.get());

                    logger.write(Level.MAINSTEP, "Iteration %d%n", statsHolder.iteration);
                    logger.write(Level.MAINSTEP, "| Checking abstraction...%n");
                    final long abstractorStartTime = stopwatch.elapsed(TimeUnit.MILLISECONDS);
                    abstractorResult.set(abstractor.check(proof, prec.get()));
                    statsHolder.abstractorTime +=
                        stopwatch.elapsed(TimeUnit.MILLISECONDS) - abstractorStartTime;
                    logger.write(
                        Level.MAINSTEP, "| Checking abstraction done, result: %s%n", abstractorResult.get());

                    if (WebDebuggerLogger.enabled()) {
                        String argGraph =
                            JSONWriter.getInstance().writeString(proofVisualizer.visualize(proof));
                        String precString = prec.get().toString();
                        wdl.addIteration(statsHolder.iteration, argGraph, precString);
                    }

                    if (abstractorResult.get().isUnsafe()) {
                        MonitorCheckpoint.Checkpoints.execute("CegarChecker.unsafeARG");

                        P lastPrec = prec.get();
                        logger.write(Level.MAINSTEP, "| Refining abstraction...%n");
                        final long refinerStartTime = stopwatch.elapsed(TimeUnit.MILLISECONDS);
                        refinerResult.set(refiner.refine(proof, prec.get()));
                        statsHolder.refinerTime +=
                            stopwatch.elapsed(TimeUnit.MILLISECONDS) - refinerStartTime;
                        logger.write(
                            Level.MAINSTEP, "Refining abstraction done, result: %s%n", refinerResult.get());

                        if (refinerResult.get().isSpurious()) {
                            prec.set(refinerResult.get().asSpurious().getRefinedPrec());
                        }

                        if (lastPrec.equals(prec.get())) {
                            logger.write(
                                Level.MAINSTEP,
                                "! Precision did NOT change in this iteration"
                                + System.lineSeparator());
                        } else {
                            logger.write(
                                Level.MAINSTEP,
                                "! Precision DID change in this iteration" + System.lineSeparator());
                        }
                    }
                } while (!abstractorResult.get().isSafe() && (refinerResult.get() == null || !refinerResult.get().isUnsafe()));

                // Set the result based on final state
                final CegarStatistics stats = getStats.get();
                if (abstractorResult.get().isSafe()) {
                    result.set(SafetyResult.safe(proof, stats));
                } else if (refinerResult.get() != null && refinerResult.get().isUnsafe()) {
                    result.set(SafetyResult.unsafe(refinerResult.get().asUnsafe().getCex(), proof, stats));
                }

            } catch (RuntimeException e) {
                if (computePartialResult) {
                    if (e instanceof NotSolvableException) {
                        logger.write(Level.MAINSTEP, "----Infinite Loop Detected by CexMonitor----%n");
                    } else {
                        logger.write(Level.MAINSTEP, "--------------Some Solver Error-------------%n");
                    }

                    abstractor.unroll(proof, prec.get());
                    logger.write(Level.MAINSTEP, "Abstractor unrolled successfully!%n");
                    result.set(SafetyResult.partial(proof, getStats.get()));
                } else {
                    throw e;
                }
            }
        });

        if (timeoutMs > 0) {
            timer.schedule(new TimerTask() {
                @Override
                public void run() {
                    cegarLoop.stop(); // Using deprecated Thread.stop() as requested
                    logger.write(Level.MAINSTEP, "----------Timeout Exceeded (%d ms)----------%n", timeoutMs);
                    abstractor.unroll(proofCopy.get(), precCopy.get());
                    logger.write(Level.MAINSTEP, "Abstractor unrolled successfully!%n");
                    result.set(SafetyResult.partial(proof, getStats.get()));
                }
            }, timeoutMs);
        }

        cegarLoop.start();
        
        try {
            cegarLoop.join(); // Wait for the CEGAR loop to complete
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            throw new RuntimeException("CEGAR loop interrupted", e);
        }
        
        timer.cancel();

        SafetyResult<Pr, C> cegarResult = result.get();
        
        if (cegarResult == null) {
            // Fallback if no result was set
            final CegarStatistics stats = getStats.get();
            assert abstractorResult.get().isSafe() || (refinerResult.get() != null && refinerResult.get().isUnsafe());

            if (abstractorResult.get().isSafe()) {
                cegarResult = SafetyResult.safe(proof, stats);
            } else if (refinerResult.get() != null && refinerResult.get().isUnsafe()) {
                cegarResult = SafetyResult.unsafe(refinerResult.get().asUnsafe().getCex(), proof, stats);
            }
        }

        assert cegarResult != null;
        logger.write(Level.RESULT, "%s%n", cegarResult);
        logger.write(Level.INFO, "%s%n", getStats.get());
        return cegarResult;
    }

    @Override
    public String toString() {
        return Utils.lispStringBuilder(getClass().getSimpleName())
                .add(abstractor)
                .add(refiner)
                .toString();
    }
}
