package hu.bme.mit.theta.analysis.algorithm.cegar

import com.google.common.base.Stopwatch
import hu.bme.mit.theta.analysis.Cex
import hu.bme.mit.theta.analysis.Prec
import hu.bme.mit.theta.analysis.algorithm.Proof
import hu.bme.mit.theta.analysis.algorithm.SafetyChecker
import hu.bme.mit.theta.analysis.algorithm.SafetyResult
import hu.bme.mit.theta.analysis.runtimemonitor.MonitorCheckpoint
import hu.bme.mit.theta.analysis.utils.ProofVisualizer
import hu.bme.mit.theta.common.Utils
import hu.bme.mit.theta.common.exception.NotSolvableException
import hu.bme.mit.theta.common.logging.Logger
import hu.bme.mit.theta.common.logging.Logger.Level
import hu.bme.mit.theta.common.logging.NullLogger
import hu.bme.mit.theta.common.visualization.writer.JSONWriter
import hu.bme.mit.theta.common.visualization.writer.WebDebuggerLogger
import java.util.concurrent.TimeUnit
import kotlin.time.Duration.Companion.milliseconds
import kotlinx.coroutines.TimeoutCancellationException
import kotlinx.coroutines.withTimeout

/**
 * Counterexample-Guided Abstraction Refinement (CEGAR) loop implementation, that uses an Abstractor
 * to explore the abstract state space and a Refiner to check counterexamples and refine them if
 * needed. It also provides certain statistics about its execution.
 */
class CegarChecker<P : Prec, Pr : Proof, C : Cex> private constructor(
    private val abstractor: Abstractor<P, Pr>,
    private val refiner: Refiner<P, Pr, C>,
    private val logger: Logger,
    private val proofVisualizer: ProofVisualizer<in Pr>,
    private val computePartialResult: Boolean,
    private val timeoutMs: Long // 0 means no timeout
) : SafetyChecker<Pr, C, P> {

    val proof: Pr = abstractor.createProof()

    private data class StatsHolder(
        var abstractorTime: Long = 0,
        var refinerTime: Long = 0,
        var iteration: Int = 0
    )

    override suspend fun check(initPrec: P): SafetyResult<Pr, C> {
        logger.write(Level.INFO, "Configuration: %s%n", this)
        val stopwatch = Stopwatch.createStarted()
        val statsHolder = StatsHolder()
        val getStats = {
            stopwatch.stop()
            CegarStatistics(
                stopwatch.elapsed(TimeUnit.MILLISECONDS),
                statsHolder.abstractorTime,
                statsHolder.refinerTime,
                statsHolder.iteration
            )
        }
        var refinerResult: RefinerResult<P, C>? = null
        var abstractorResult: AbstractorResult
        var prec: P = initPrec
        val wdl = WebDebuggerLogger.getInstance()

        try {
            if (timeoutMs > 0) {
                withTimeout(timeoutMs.milliseconds) {
                    runCegarLoop(statsHolder, prec, stopwatch, wdl, refinerResult, initPrec)
                }
            } else {
                runCegarLoop(statsHolder, prec, stopwatch, wdl, refinerResult, initPrec)
            }
        } catch (e: RuntimeException) {
            if (computePartialResult) {
                when (e) {
                    is TimeoutCancellationException -> {
                        logger.write(Level.MAINSTEP, "----------Timeout Exceeded (%d ms)----------%n", timeoutMs)
                    }
                    is NotSolvableException -> {
                        logger.write(Level.MAINSTEP, "----Infinite Loop Detected by CexMonitor----%n")
                    }
                    else -> {
                        logger.write(Level.MAINSTEP, "--------------Some Solver Error-------------%n")
                    }
                }

                abstractor.unroll(proof, prec)
                logger.write(Level.MAINSTEP, "Abstractor unrolled successfully!%n")
                return SafetyResult.partial(proof, getStats())
            } else {
                throw e
            }
        }

        val stats = getStats()
        val finalAbstractorResult = (getInternalState() as CegarLoopInternalState<P, C>).abstractorResult
        val finalRefinerResult = (getInternalState() as CegarLoopInternalState<P, C>).refinerResult

        assert(finalAbstractorResult.isSafe || finalRefinerResult!!.isUnsafe)

        val cegarResult = if (finalAbstractorResult.isSafe) {
            SafetyResult.safe(proof, stats)
        } else if (finalRefinerResult!!.isUnsafe) {
            SafetyResult.unsafe(finalRefinerResult.asUnsafe().cex, proof, stats)
        } else {
            throw IllegalStateException("Cegar loop finished with an unexpected state.")
        }

        logger.write(Level.RESULT, "%s%n", cegarResult)
        logger.write(Level.INFO, "%s%n", stats)
        return cegarResult
    }

    private suspend fun runCegarLoop(
        statsHolder: StatsHolder,
        initialPrec: P,
        stopwatch: Stopwatch,
        wdl: WebDebuggerLogger,
        initialRefinerResult: RefinerResult<P, C>?,
        initPrec: P
    ) {
        var prec = initialPrec
        var refinerResult = initialRefinerResult
        lateinit var abstractorResult: AbstractorResult

        do {
            statsHolder.iteration++

            logger.write(Level.MAINSTEP, "Iteration %d%n", statsHolder.iteration)
            logger.write(Level.MAINSTEP, "| Checking abstraction...%n")
            val abstractorStartTime = stopwatch.elapsed(TimeUnit.MILLISECONDS)
            abstractorResult = abstractor.check(proof, prec)
            statsHolder.abstractorTime += stopwatch.elapsed(TimeUnit.MILLISECONDS) - abstractorStartTime
            logger.write(Level.MAINSTEP, "| Checking abstraction done, result: %s%n", abstractorResult)

            if (WebDebuggerLogger.enabled()) {
                val argGraph = JSONWriter.getInstance().writeString(proofVisualizer.visualize(proof))
                val precString = prec.toString()
                wdl.addIteration(statsHolder.iteration, argGraph, precString)
            }

            if (abstractorResult.isUnsafe) {
                MonitorCheckpoint.Checkpoints.execute("CegarChecker.unsafeARG")

                val lastPrec = prec
                logger.write(Level.MAINSTEP, "| Refining abstraction...%n")
                val refinerStartTime = stopwatch.elapsed(TimeUnit.MILLISECONDS)
                refinerResult = refiner.refine(proof, prec)
                statsHolder.refinerTime += stopwatch.elapsed(TimeUnit.MILLISECONDS) - refinerStartTime
                logger.write(Level.MAINSTEP, "Refining abstraction done, result: %s%n", refinerResult)

                if (refinerResult.isSpurious) {
                    prec = refinerResult.asSpurious().refinedPrec
                }

                if (lastPrec == prec) {
                    logger.write(Level.MAINSTEP, "! Precision did NOT change in this iteration%n")
                } else {
                    logger.write(Level.MAINSTEP, "! Precision DID change in this iteration%n")
                }
            }
        } while (!abstractorResult.isSafe && (refinerResult == null || !refinerResult.isUnsafe))
        
        // Save the final state to be retrieved after the coroutine completes
        setInternalState(CegarLoopInternalState(abstractorResult, refinerResult))
    }
    
    @Volatile
    private var internalState: Any? = null

    private fun setInternalState(state: Any?) {
        this.internalState = state
    }

    private fun getInternalState(): Any? {
        return this.internalState
    }

    private data class CegarLoopInternalState<P : Prec, C : Cex>(
        val abstractorResult: AbstractorResult,
        val refinerResult: RefinerResult<P, C>?
    )


    override fun toString(): String {
        return Utils.lispStringBuilder(javaClass.simpleName)
            .add(abstractor)
            .add(refiner)
            .toString()
    }

    companion object {
        fun <P : Prec, Pr : Proof, C : Cex> create(
            abstractor: Abstractor<P, Pr>,
            refiner: Refiner<P, Pr, C>,
            logger: Logger,
            proofVisualizer: ProofVisualizer<in Pr>,
            computePartialResult: Boolean,
            timeoutMs: Long
        ): CegarChecker<P, Pr, C> {
            return CegarChecker(
                abstractor, refiner, logger, proofVisualizer, computePartialResult, timeoutMs
            )
        }

        fun <P : Prec, Pr : Proof, C : Cex> create(
            abstractor: Abstractor<P, Pr>,
            refiner: Refiner<P, Pr, C>,
            proofVisualizer: ProofVisualizer<Pr>,
            computePartialResult: Boolean
        ): CegarChecker<P, Pr, C> {
            return create(abstractor, refiner, NullLogger.getInstance(), proofVisualizer, computePartialResult, 0)
        }

        fun <P : Prec, Pr : Proof, C : Cex> create(
            abstractor: Abstractor<P, Pr>,
            refiner: Refiner<P, Pr, C>,
            proofVisualizer: ProofVisualizer<Pr>
        ): CegarChecker<P, Pr, C> {
            return create(abstractor, refiner, NullLogger.getInstance(), proofVisualizer, false, 0)
        }

        fun <P : Prec, Pr : Proof, C : Cex> create(
            abstractor: Abstractor<P, Pr>,
            refiner: Refiner<P, Pr, C>,
            logger: Logger,
            proofVisualizer: ProofVisualizer<in Pr>
        ): CegarChecker<P, Pr, C> {
            return create(abstractor, refiner, logger, proofVisualizer, false, 0)
        }
    }
}
